# ================================================================
# Velocity stdlib — html module  (pure Velocity)
# HTML5 parser — produces a full DOM tree with parent pointers.
#
# Requires: anaw memory; in the importing program.
#
# Node layout (64 bytes, opaque adad handle):
#   [+0]  type         adad  1=element 2=text 3=doctype 4=comment
#   [+8]  parent       adad  parent node ptr (0 for root)
#   [+16] first_child  adad
#   [+24] last_child   adad
#   [+32] next_sib     adad
#   [+40] prev_sib     adad
#   [+48] tag          adad  malloc'd tag name (lowercase)
#   [+56] text         adad  malloc'd text content
#
# AttrNode layout (32 bytes):
#   [+0]  next   adad
#   [+8]  name   adad  malloc'd
#   [+16] value  adad  malloc'd
#   [+24] _pad
#
# Attrs are stored on element nodes via a separate attrs_head pointer
# hanging off node_attrs(node) = load64(node + 64) — node is 72 bytes total.
#
# Public API:
#   html.parse(src)              -> adad  root node (document)
#   html.free(node)              -> khali frees entire tree
#   html.type(node)              -> adad
#   html.tag(node)               -> lafz
#   html.text(node)              -> lafz
#   html.parent(node)            -> adad
#   html.first_child(node)       -> adad
#   html.last_child(node)        -> adad
#   html.next_sib(node)          -> adad
#   html.prev_sib(node)          -> adad
#   html.attr(node, name)        -> lafz  (0 if not found)
#   html.has_attr(node, name)    -> adad  1/0
#   html.find(node, tag)         -> adad  first descendant with tag
#   html.find_by_id(node, id)    -> adad
#   html.find_all(node, tag, out_arr, max) -> adad  count
#   html.inner_text(node, buf, len) -> adad  length written
#   html.child_count(node)       -> adad
#   html.nth_child(node, n)      -> adad  0-indexed
# ================================================================

saabit NODE_SIZE  = 72;
saabit N_TYPE     = 0;
saabit N_PARENT   = 8;
saabit N_FCHILD   = 16;
saabit N_LCHILD   = 24;
saabit N_NEXT     = 32;
saabit N_PREV     = 40;
saabit N_TAG      = 48;
saabit N_TEXT     = 56;
saabit N_ATTRS    = 64;

saabit ATTR_SIZE  = 32;
saabit A_NEXT     = 0;
saabit A_NAME     = 8;
saabit A_VALUE    = 16;

saabit NODE_ELEMENT = 1;
saabit NODE_TEXT    = 2;
saabit NODE_DOCTYPE = 3;
saabit NODE_COMMENT = 4;
saabit NODE_DOC     = 5;

# ---- internal node constructors ----

kar _node_new(typ: adad) -> adad {
    ath n: adad = _vel_mem__calloc(1, NODE_SIZE);
    _vel_mem__store64(n + N_TYPE, typ);
    chu n;
}

kar _node_append(parent: adad, child: adad) -> khali {
    _vel_mem__store64(child + N_PARENT, parent);
    ath lc: adad = _vel_mem__load64(parent + N_LCHILD);
    agar lc == 0 {
        _vel_mem__store64(parent + N_FCHILD, child);
        _vel_mem__store64(parent + N_LCHILD, child);
        chu 0;
    }
    _vel_mem__store64(lc + N_NEXT, child);
    _vel_mem__store64(child + N_PREV, lc);
    _vel_mem__store64(parent + N_LCHILD, child);
}

# ---- internal string helpers ----

# copy src[start..end) into a new malloc'd string
kar _strsub(src: adad, start: adad, end_pos: adad) -> adad {
    ath len: adad = end_pos - start;
    agar len <= 0 { chu _vel_mem__strdup(""); }
    ath buf: adad = _vel_mem__malloc(len + 1);
    _vel_mem__memcpy(buf, src + start, len);
    _vel_mem__store8(buf + len, 0);
    chu buf;
}

# lowercase a char (ASCII only)
kar _tolower(c: adad) -> adad {
    agar c >= 65 { agar c <= 90 { chu c + 32; } }
    chu c;
}

# copy src[start..end) lowercased into new malloc'd string
kar _strsub_lower(src: adad, start: adad, end_pos: adad) -> adad {
    ath len: adad = end_pos - start;
    agar len <= 0 { chu _vel_mem__strdup(""); }
    ath buf: adad = _vel_mem__malloc(len + 1);
    ath mut i: adad = 0;
    yeli i < len {
        ath c: adad = _vel_mem__load8(src + start + i);
        _vel_mem__store8(buf + i, _tolower(c));
        i = i + 1;
    }
    _vel_mem__store8(buf + len, 0);
    chu buf;
}

# skip whitespace, return new pos
kar _skip_ws(src: adad, pos: adad) -> adad {
    ath mut p: adad = pos;
    yeli 1 == 1 {
        ath c: adad = _vel_mem__load8(src + p);
        agar c == 32  { p = p + 1; pakh; }
        agar c == 9   { p = p + 1; pakh; }
        agar c == 10  { p = p + 1; pakh; }
        agar c == 13  { p = p + 1; pakh; }
        phutraw;
    }
    chu p;
}

# strcmp for adad pointers
kar _streq(a: lafz, b: lafz) -> adad {
    chu _vel_mem__strcmp(a, b) == 0;
}

# ---- attribute helpers ----

kar _attr_set(node: adad, name: lafz, value: lafz) -> khali {
    # check if attr already exists → update
    ath mut cur: adad = _vel_mem__load64(node + N_ATTRS);
    yeli cur != 0 {
        ath aname: lafz = _vel_mem__load64(cur + A_NAME);
        agar _streq(aname, name) == 1 {
            ath old: adad = _vel_mem__load64(cur + A_VALUE);
            agar old != 0 { _vel_mem__free(old); }
            _vel_mem__store64(cur + A_VALUE, _vel_mem__strdup(value));
            chu 0;
        }
        cur = _vel_mem__load64(cur + A_NEXT);
    }
    # new attr node
    ath a: adad = _vel_mem__calloc(1, ATTR_SIZE);
    _vel_mem__store64(a + A_NAME,  _vel_mem__strdup(name));
    _vel_mem__store64(a + A_VALUE, _vel_mem__strdup(value));
    # prepend to attr list
    ath head: adad = _vel_mem__load64(node + N_ATTRS);
    _vel_mem__store64(a + A_NEXT, head);
    _vel_mem__store64(node + N_ATTRS, a);
}

# ---- parser state ----
# We pass parser state as individual adad args to avoid struct complexity.
# State: src (adad), pos (adad ptr), len (adad)

kar _parse_attr_value(src: adad, pos: adad, slen: adad, out_end: adad) -> adad {
    # pos points to opening quote or unquoted value start
    ath c: adad = _vel_mem__load8(src + pos);
    ath mut p: adad = pos;
    ath mut quote: adad = 0;

    agar c == 34 { quote = 34; p = p + 1; }  # "
    agar c == 39 { quote = 39; p = p + 1; }  # '

    ath start: adad = p;
    agar quote != 0 {
        yeli p < slen {
            ath ch: adad = _vel_mem__load8(src + p);
            agar ch == quote { phutraw; }
            agar ch == 0     { phutraw; }
            p = p + 1;
        }
        ath val: adad = _strsub(src, start, p);
        agar p < slen { p = p + 1; }  # skip closing quote
        _vel_mem__store64(out_end, p);
        chu val;
    }
    # unquoted: read until whitespace or >
    yeli p < slen {
        ath ch: adad = _vel_mem__load8(src + p);
        agar ch == 32  { phutraw; }
        agar ch == 62  { phutraw; }  # >
        agar ch == 47  { phutraw; }  # /
        agar ch == 0   { phutraw; }
        p = p + 1;
    }
    ath val: adad = _strsub(src, start, p);
    _vel_mem__store64(out_end, p);
    chu val;
}

# Parse attributes inside a tag. pos is right after the tag name.
# Returns pos after attributes (pointing at > or /).
kar _parse_attrs(src: adad, pos: adad, slen: adad, node: adad) -> adad {
    ath mut p: adad = pos;
    yeli p < slen {
        p = _skip_ws(src, p);
        ath c: adad = _vel_mem__load8(src + p);
        agar c == 62  { phutraw; }   # >
        agar c == 47  { phutraw; }   # /
        agar c == 0   { phutraw; }

        # read attr name
        ath name_start: adad = p;
        yeli p < slen {
            ath ch: adad = _vel_mem__load8(src + p);
            agar ch == 61  { phutraw; }   # =
            agar ch == 32  { phutraw; }   # space
            agar ch == 62  { phutraw; }   # >
            agar ch == 47  { phutraw; }   # /
            agar ch == 0   { phutraw; }
            p = p + 1;
        }
        agar p == name_start { p = p + 1; pakh; }  # skip bad char

        ath name: adad = _strsub_lower(src, name_start, p);
        p = _skip_ws(src, p);

        ath eq: adad = _vel_mem__load8(src + p);
        agar eq == 61 {   # has value
            p = p + 1;
            p = _skip_ws(src, p);
            ath end_ptr: adad = _vel_mem__malloc(8);
            ath value: adad = _parse_attr_value(src, p, slen, end_ptr);
            p = _vel_mem__load64(end_ptr);
            _vel_mem__free(end_ptr);
            _attr_set(node, name, value);
            _vel_mem__free(value);
        }
        agar eq != 61 {   # boolean attr (no value)
            _attr_set(node, name, "");
        }
        _vel_mem__free(name);
    }
    chu p;
}

# void elements — no closing tag
kar _is_void(tag: lafz) -> adad {
    agar _streq(tag, "area")    == 1 { chu 1; }
    agar _streq(tag, "base")    == 1 { chu 1; }
    agar _streq(tag, "br")      == 1 { chu 1; }
    agar _streq(tag, "col")     == 1 { chu 1; }
    agar _streq(tag, "embed")   == 1 { chu 1; }
    agar _streq(tag, "hr")      == 1 { chu 1; }
    agar _streq(tag, "img")     == 1 { chu 1; }
    agar _streq(tag, "input")   == 1 { chu 1; }
    agar _streq(tag, "link")    == 1 { chu 1; }
    agar _streq(tag, "meta")    == 1 { chu 1; }
    agar _streq(tag, "param")   == 1 { chu 1; }
    agar _streq(tag, "source")  == 1 { chu 1; }
    agar _streq(tag, "track")   == 1 { chu 1; }
    agar _streq(tag, "wbr")     == 1 { chu 1; }
    chu 0;
}

# raw text elements — content not parsed as HTML
kar _is_raw(tag: lafz) -> adad {
    agar _streq(tag, "script") == 1 { chu 1; }
    agar _streq(tag, "style")  == 1 { chu 1; }
    chu 0;
}

# ---- main parse loop ----

kar _parse_nodes(src: adad, pos: adad, slen: adad, parent: adad) -> adad {
    ath mut p: adad = pos;

    yeli p < slen {
        ath c: adad = _vel_mem__load8(src + p);
        agar c == 0 { phutraw; }

        # --- closing tag: stop parsing children ---
        agar c == 60 {   # '<'
            ath c1: adad = _vel_mem__load8(src + p + 1);
            agar c1 == 47 {  # '/' → closing tag
                # skip to '>'
                yeli p < slen {
                    ath ch: adad = _vel_mem__load8(src + p);
                    agar ch == 62 { p = p + 1; phutraw; }
                    p = p + 1;
                }
                phutraw;   # return to caller
            }

            # --- comment: <!-- ... --> ---
            agar c1 == 33 {
                ath c2: adad = _vel_mem__load8(src + p + 2);
                ath c3: adad = _vel_mem__load8(src + p + 3);
                agar c2 == 45 { agar c3 == 45 {  # <!--
                    p = p + 4;
                    ath cstart: adad = p;
                    yeli p < slen {
                        ath ch0: adad = _vel_mem__load8(src + p);
                        ath ch1: adad = _vel_mem__load8(src + p + 1);
                        ath ch2: adad = _vel_mem__load8(src + p + 2);
                        agar ch0 == 45 { agar ch1 == 45 { agar ch2 == 62 {
                            ath cnode: adad = _node_new(NODE_COMMENT);
                            ath ctxt: adad = _strsub(src, cstart, p);
                            _vel_mem__store64(cnode + N_TEXT, ctxt);
                            _node_append(parent, cnode);
                            p = p + 3;
                            phutraw;
                        } } }
                        p = p + 1;
                    }
                    pakh;  # continue outer loop
                } }
                # <!DOCTYPE
                p = p + 2;
                yeli p < slen {
                    ath ch: adad = _vel_mem__load8(src + p);
                    agar ch == 62 { p = p + 1; phutraw; }
                    p = p + 1;
                }
                pakh;
            }

            # --- opening tag ---
            p = p + 1;  # skip '<'
            ath tag_start: adad = p;
            yeli p < slen {
                ath ch: adad = _vel_mem__load8(src + p);
                agar ch == 32  { phutraw; }
                agar ch == 62  { phutraw; }
                agar ch == 47  { phutraw; }
                agar ch == 0   { phutraw; }
                p = p + 1;
            }
            ath tag_len: adad = p - tag_start;
            agar tag_len == 0 { pakh; }

            ath tag: adad = _strsub_lower(src, tag_start, p);
            ath elem: adad = _node_new(NODE_ELEMENT);
            _vel_mem__store64(elem + N_TAG, tag);

            # parse attributes
            p = _parse_attrs(src, p, slen, elem);

            # self-closing or void?
            ath after_attrs: adad = _vel_mem__load8(src + p);
            ath mut is_self: adad = 0;
            agar after_attrs == 47 {   # '/'
                is_self = 1;
                p = p + 1;
            }
            agar _vel_mem__load8(src + p) == 62 { p = p + 1; }  # '>'

            _node_append(parent, elem);

            # recurse into children unless void/self-closing
            agar is_self == 0 {
                agar _is_void(tag) == 0 {
                    agar _is_raw(tag) == 0 {
                        p = _parse_nodes(src, p, slen, elem);
                    }
                    agar _is_raw(tag) == 1 {
                        # raw: collect until </tag>
                        ath rstart: adad = p;
                        ath mut rp: adad = p;
                        ath tlen: adad = _vel_mem__strlen(tag);
                        yeli rp < slen {
                            ath rc: adad = _vel_mem__load8(src + rp);
                            agar rc == 60 {
                                agar _vel_mem__load8(src + rp + 1) == 47 {
                                    ath rtxt: adad = _strsub(src, rstart, rp);
                                    ath tnode: adad = _node_new(NODE_TEXT);
                                    _vel_mem__store64(tnode + N_TEXT, rtxt);
                                    _node_append(elem, tnode);
                                    # skip </tag>
                                    rp = rp + 2;
                                    yeli rp < slen {
                                        ath rc2: adad = _vel_mem__load8(src + rp);
                                        agar rc2 == 62 { rp = rp + 1; phutraw; }
                                        rp = rp + 1;
                                    }
                                    phutraw;
                                }
                            }
                            rp = rp + 1;
                        }
                        p = rp;
                    }
                }
            }
            pakh;  # continue outer loop
        }

        # --- text node ---
        ath tstart: adad = p;
        yeli p < slen {
            ath ch: adad = _vel_mem__load8(src + p);
            agar ch == 60  { phutraw; }   # '<'
            agar ch == 0   { phutraw; }
            p = p + 1;
        }
        agar p > tstart {
            # skip whitespace-only text nodes
            ath mut all_ws: adad = 1;
            ath mut wi: adad = tstart;
            yeli wi < p {
                ath wc: adad = _vel_mem__load8(src + wi);
                agar wc != 32  {
                    agar wc != 9  {
                        agar wc != 10 {
                            agar wc != 13 { all_ws = 0; phutraw; }
                        }
                    }
                }
                wi = wi + 1;
            }
            agar all_ws == 0 {
                ath tnode: adad = _node_new(NODE_TEXT);
                ath tcontent: adad = _strsub(src, tstart, p);
                _vel_mem__store64(tnode + N_TEXT, tcontent);
                _node_append(parent, tnode);
            }
        }
    }
    chu p;
}

# ---- public: parse ----

kar parse(src: lafz) -> adad {
    ath doc: adad = _node_new(NODE_DOC);
    ath slen: adad = _vel_mem__strlen(src);
    _parse_nodes(src, 0, slen, doc);
    chu doc;
}

# ---- public: free ----

kar _free_attrs(a: adad) -> khali {
    ath mut cur: adad = a;
    yeli cur != 0 {
        ath nxt: adad = _vel_mem__load64(cur + A_NEXT);
        ath nm:  adad = _vel_mem__load64(cur + A_NAME);
        ath vl:  adad = _vel_mem__load64(cur + A_VALUE);
        agar nm != 0 { _vel_mem__free(nm); }
        agar vl != 0 { _vel_mem__free(vl); }
        _vel_mem__free(cur);
        cur = nxt;
    }
}

kar free(node: adad) -> khali {
    agar node == 0 { chu 0; }
    # recurse children first
    ath mut child: adad = _vel_mem__load64(node + N_FCHILD);
    yeli child != 0 {
        ath nxt: adad = _vel_mem__load64(child + N_NEXT);
        free(child);
        child = nxt;
    }
    _free_attrs(_vel_mem__load64(node + N_ATTRS));
    ath tg: adad = _vel_mem__load64(node + N_TAG);
    ath tx: adad = _vel_mem__load64(node + N_TEXT);
    agar tg != 0 { _vel_mem__free(tg); }
    agar tx != 0 { _vel_mem__free(tx); }
    _vel_mem__free(node);
}

# ---- public: accessors ----

kar type(node: adad)        -> adad { chu _vel_mem__load64(node + N_TYPE); }
kar tag(node: adad)         -> lafz { chu _vel_mem__load64(node + N_TAG); }
kar text(node: adad)        -> lafz { chu _vel_mem__load64(node + N_TEXT); }
kar parent(node: adad)      -> adad { chu _vel_mem__load64(node + N_PARENT); }
kar first_child(node: adad) -> adad { chu _vel_mem__load64(node + N_FCHILD); }
kar last_child(node: adad)  -> adad { chu _vel_mem__load64(node + N_LCHILD); }
kar next_sib(node: adad)    -> adad { chu _vel_mem__load64(node + N_NEXT); }
kar prev_sib(node: adad)    -> adad { chu _vel_mem__load64(node + N_PREV); }

kar attr(node: adad, name: lafz) -> lafz {
    ath mut cur: adad = _vel_mem__load64(node + N_ATTRS);
    yeli cur != 0 {
        ath aname: lafz = _vel_mem__load64(cur + A_NAME);
        agar _streq(aname, name) == 1 {
            chu _vel_mem__load64(cur + A_VALUE);
        }
        cur = _vel_mem__load64(cur + A_NEXT);
    }
    chu 0;
}

kar has_attr(node: adad, name: lafz) -> adad {
    ath mut cur: adad = _vel_mem__load64(node + N_ATTRS);
    yeli cur != 0 {
        ath aname: lafz = _vel_mem__load64(cur + A_NAME);
        agar _streq(aname, name) == 1 { chu 1; }
        cur = _vel_mem__load64(cur + A_NEXT);
    }
    chu 0;
}

# ---- public: traversal ----

kar child_count(node: adad) -> adad {
    ath mut n: adad = 0;
    ath mut cur: adad = _vel_mem__load64(node + N_FCHILD);
    yeli cur != 0 {
        n = n + 1;
        cur = _vel_mem__load64(cur + N_NEXT);
    }
    chu n;
}

kar nth_child(node: adad, idx: adad) -> adad {
    ath mut i: adad = 0;
    ath mut cur: adad = _vel_mem__load64(node + N_FCHILD);
    yeli cur != 0 {
        agar i == idx { chu cur; }
        i = i + 1;
        cur = _vel_mem__load64(cur + N_NEXT);
    }
    chu 0;
}

# depth-first find: first descendant element with matching tag
kar find(node: adad, tg: lafz) -> adad {
    ath mut cur: adad = _vel_mem__load64(node + N_FCHILD);
    yeli cur != 0 {
        ath nxt: adad = _vel_mem__load64(cur + N_NEXT);
        agar _vel_mem__load64(cur + N_TYPE) == NODE_ELEMENT {
            ath ctag: lafz = _vel_mem__load64(cur + N_TAG);
            agar ctag != 0 {
                agar _streq(ctag, tg) == 1 { chu cur; }
            }
        }
        ath found: adad = find(cur, tg);
        agar found != 0 { chu found; }
        cur = nxt;
    }
    chu 0;
}

# find element with id="..."
kar find_by_id(node: adad, id: lafz) -> adad {
    ath mut cur: adad = _vel_mem__load64(node + N_FCHILD);
    yeli cur != 0 {
        ath nxt: adad = _vel_mem__load64(cur + N_NEXT);
        agar _vel_mem__load64(cur + N_TYPE) == NODE_ELEMENT {
            ath vid: lafz = attr(cur, "id");
            agar vid != 0 {
                agar _streq(vid, id) == 1 { chu cur; }
            }
        }
        ath found: adad = find_by_id(cur, id);
        agar found != 0 { chu found; }
        cur = nxt;
    }
    chu 0;
}

# collect all descendants with matching tag into out_arr (array of adad)
kar find_all(node: adad, tg: lafz, out_arr: adad, max: adad) -> adad {
    ath mut count: adad = 0;
    ath mut cur: adad = _vel_mem__load64(node + N_FCHILD);
    yeli cur != 0 {
        ath nxt: adad = _vel_mem__load64(cur + N_NEXT);
        agar _vel_mem__load64(cur + N_TYPE) == NODE_ELEMENT {
            ath ctag: lafz = _vel_mem__load64(cur + N_TAG);
            agar ctag != 0 {
                agar _streq(ctag, tg) == 1 {
                    agar count < max {
                        _vel_mem__store64(out_arr + count * 8, cur);
                        count = count + 1;
                    }
                }
            }
        }
        # recurse
        ath sub: adad = _vel_mem__malloc(8);
        _vel_mem__store64(sub, 0);
        ath sub_count: adad = find_all(cur, tg, out_arr + count * 8, max - count);
        _vel_mem__free(sub);
        count = count + sub_count;
        cur = nxt;
    }
    chu count;
}

# collect all text content under a node into buf
kar inner_text(node: adad, buf: adad, buf_len: adad) -> adad {
    ath mut pos: adad = 0;
    ath mut cur: adad = _vel_mem__load64(node + N_FCHILD);
    yeli cur != 0 {
        ath nxt: adad = _vel_mem__load64(cur + N_NEXT);
        ath ctype: adad = _vel_mem__load64(cur + N_TYPE);
        agar ctype == NODE_TEXT {
            ath tx: lafz = _vel_mem__load64(cur + N_TEXT);
            agar tx != 0 {
                ath tlen: adad = _vel_mem__strlen(tx);
                ath mut copy: adad = tlen;
                agar pos + copy > buf_len { copy = buf_len - pos; }
                agar copy > 0 {
                    _vel_mem__memcpy(buf + pos, tx, copy);
                    pos = pos + copy;
                }
            }
        }
        agar ctype == NODE_ELEMENT {
            pos = pos + inner_text(cur, buf + pos, buf_len - pos);
        }
        cur = nxt;
    }
    agar pos < buf_len { _vel_mem__store8(buf + pos, 0); }
    chu pos;
}
